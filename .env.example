# ---------------------------------------------------------------------------
# Frontline Personal Agent — environment
#
# Copy to .env and fill in. Nothing here is required to run in local/mock mode;
# `make demo` works with this file untouched.
# ---------------------------------------------------------------------------

# `local`  — mock connectors, mock token vault, JSONL audit log. No AWS needed.
# `aws`    — real AgentCore Identity/Memory/Gateway, real connectors, DynamoDB audit.
FRONTLINE_AGENT_MODE=local

# --- Slack -----------------------------------------------------------------
# Create the app from manifest/slack-app-manifest.yaml, then fill these in.
# Bot token: attribution + posting.        App settings -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-
# Signing secret: request verification.    App settings -> Basic Information
SLACK_SIGNING_SECRET=
# App-level token: local dev only (Socket Mode). App settings -> Basic Information
SLACK_APP_TOKEN=xapp-
# The principal this agent acts for. Slack member ID (e.g. U01ABCDEFGH).
PRINCIPAL_SLACK_USER_ID=

# User token (xoxp-) for read-side retrieval as the principal.
# In `aws` mode leave this EMPTY — it is issued and refreshed by AgentCore
# Identity's token vault. It exists here only so local dev can run without AWS.
# See docs/03-identity-and-access.md before you paste a real one in.
SLACK_USER_TOKEN=

# --- Bedrock / model -------------------------------------------------------
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
ANTHROPIC_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0
ANTHROPIC_SMALL_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Hard per-turn spend ceiling in USD. The agent loop aborts when it is crossed.
MAX_TURN_BUDGET_USD=2.00

# --- AgentCore -------------------------------------------------------------
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_WORKLOAD_IDENTITY=frontline-cpo-agent

# --- Audit -----------------------------------------------------------------
AUDIT_TABLE_NAME=frontline-agent-audit
AUDIT_LOCAL_PATH=.audit/actions.jsonl

# --- Connectors ------------------------------------------------------------
# Credentials are NOT set here in `aws` mode. Each connector resolves a
# user-delegated OAuth token from the vault at call time, keyed by provider.
# These IDs name the OAuth credential provider registered in AgentCore Identity.
ATLASSIAN_PROVIDER_ID=atlassian-oauth
ATLASSIAN_SITE_URL=https://frontlineeducation.atlassian.net
SALESFORCE_PROVIDER_ID=salesforce-oauth
SALESFORCE_INSTANCE_URL=
ANALYTICS_PROVIDER_ID=analytics-oauth
ANALYTICS_BASE_URL=
# Source code. Read-only by design — see connectors/code.py on why there are
# no write tools and why a PAT with push scope must not be used here.
GITHUB_PROVIDER_ID=github-oauth
GITHUB_ORG=frontline-education
